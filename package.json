{
  "name": "iron",
  "private": true,
  "workspaces": ["js/*", "editor", "tests/fixtures"],
  "scripts": {
    "build": "bun run --filter iron-editor build",
    "build:fixtures": "bun run --filter iron-fixtures build",
    "typecheck": "bun run typecheck:js && bun run typecheck:examples",
    "typecheck:js": "bun run --filter '*' typecheck",
    "typecheck:examples": "cd tools && cargo run -q -p iron_build -- check ../examples --tsc",
    "test": "bun test",
    "screenshots": "bun scripts/screenshots.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
