/target
/tools/target
node_modules/
# Build output of games and the editor (`platypus-build build`, `bun run build`).
/examples/*/build/
/editor/build/
/tools/bench/*/build/
# The old output folder, no longer read: ignored so stale copies stay out of `git status`.
dist/
*.log
# Test renders (crates/platypus_render/src/testing.rs); goldens live in tests/golden.
tests/output/
# Cooked assets (`platypus-app --cook`), rebuilt from the sources.
.platypus/
# The same, from before the rename to Platypus.
.iron/
# Generated type declarations (`platypus-build types`, `init --editor-files`).
examples/*/types/
editor/types/
tools/bench/*/types/
# Asset import settings and GUIDs (`platypus-build assets`/`dev`): a build-host detail, rebuilt on demand.
*.meta
# The local list of unsafe code for review passes; kept out of the repository.
docs/AUDIT-UNSAFE-CODE.md
