{
  "description": "maxWidth clamps a growing item and its sibling takes the rest; minWidth and flex none stop shrinking, so the sibling absorbs the overflow",
  "root": [300, 150],
  "tree": {
    "id": "col", "style": { "flexDirection": "column", "width": 300, "height": 150 },
    "children": [
      {
        "id": "growRow", "style": { "width": 300, "height": 50 },
        "children": [
          { "id": "capped", "style": { "flexGrow": 1, "maxWidth": 50 } },
          { "id": "greedy", "style": { "flexGrow": 1 } }
        ]
      },
      {
        "id": "minRow", "style": { "width": 100, "height": 50 },
        "children": [
          { "id": "floor", "style": { "width": 80, "minWidth": 80 } },
          { "id": "squeezed1", "style": { "width": 80 } }
        ]
      },
      {
        "id": "noneRow", "style": { "width": 100, "height": 50 },
        "children": [
          { "id": "rigid", "style": { "width": 80, "flex": "none" } },
          { "id": "squeezed2", "style": { "width": 80 } }
        ]
      }
    ]
  },
  "expect": {
    "capped": [0, 0, 50, 50], "greedy": [50, 0, 250, 50],
    "floor": [0, 50, 80, 50], "squeezed1": [80, 50, 20, 50],
    "rigid": [0, 100, 80, 50], "squeezed2": [80, 100, 20, 50]
  }
}
